generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SearchRegion {
  US
  JP
  ES
  BR
}

enum KeywordType {
  MAIN
  LONG_TAIL
}

enum TopicType {
  MAIN
  SUB_TOPIC
}

enum RankBucket {
  TOP_5
  TOP_10
  TOP_30
  TOP_50
  TOP_100
  NOT_FOUND
}

enum RunStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

model Keyword {
  id            String            @id @default(cuid())
  text          String            @unique
  type          KeywordType       @default(MAIN)
  active        Boolean           @default(true)
  defaultVolume Int               @default(0)
  topicId       String?
  topic         Topic?            @relation(fields: [topicId], references: [id], onDelete: SetNull)
  parentId      String?
  parent        Keyword?          @relation("KeywordTree", fields: [parentId], references: [id], onDelete: SetNull)
  children      Keyword[]         @relation("KeywordTree")
  parentEdges   KeywordRelation[] @relation("KeywordRelationParent")
  childEdges    KeywordRelation[] @relation("KeywordRelationChild")
  snapshots     RankingSnapshot[]
  diffs         RankingDiff[]
  volumes       KeywordVolume[]
  observations  KeywordObservation[]
  siteLinks     SiteKeyword[]
  pageObservations KeywordPageObservation[]
  lastSyncedAt  DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([parentId])
  @@index([topicId])
  @@index([type])
  @@index([active])
}

model RankingImport {
  id          String               @id @default(cuid())
  requestId   String               @unique
  payloadHash String
  count       Int
  importedAt  DateTime             @default(now())
  observations KeywordObservation[]
  siteDomain  String?
  site        SeoSite? @relation(fields: [siteDomain], references: [domain])
  pageObservations KeywordPageObservation[]
  trafficReports WeeklyTraffic[]
  dailyRankings DailyRankingReport[]
}

model KeywordObservation {
  id           String       @id @default(cuid())
  keywordId    String
  keyword      Keyword      @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  importId     String
  importBatch  RankingImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  source       String
  region       SearchRegion
  rank         Float?
  rankReported Boolean      @default(false)
  volume       Int?
  clicks       Int?
  impressions  Int?
  ctr          Float?
  periodStart  DateTime?     @db.Date
  periodEnd    DateTime?     @db.Date
  collectedAt  DateTime
  importedAt   DateTime     @default(now())
  siteDomain   String?
  site         SeoSite? @relation(fields: [siteDomain], references: [domain])
  captureId    String?
  capture      RankingCapture? @relation(fields: [captureId], references: [id])
  url          String?
  rankStatus   String @default("no_data")
  dataUpdatedAt DateTime?

  @@unique([importId, keywordId, region, source])
  @@index([keywordId, region, source, collectedAt])
  @@index([keywordId, region, collectedAt(sort: Desc), importedAt(sort: Desc)])
  @@index([siteDomain, keywordId, region, source, collectedAt(sort: Desc)])
  @@index([captureId])
}

model SeoSite {
  domain String @id
  name String
  active Boolean @default(true)
  ga4PropertyId String?
  initializedAt DateTime?
  keywords SiteKeyword[]
  topics SiteTopic[]
  observations KeywordObservation[]
  pageObservations KeywordPageObservation[]
  captures RankingCapture[]
  imports RankingImport[]
  trafficReports WeeklyTraffic[]
  dailyRankings DailyRankingReport[]
}

model SiteTopic {
  siteDomain String
  topicId String
  site SeoSite @relation(fields: [siteDomain], references: [domain], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  @@id([siteDomain, topicId])
}

model SiteKeyword {
  siteDomain String
  keywordId String
  site SeoSite @relation(fields: [siteDomain], references: [domain], onDelete: Cascade)
  keyword Keyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  topicId String?
  topic Topic? @relation(fields: [topicId], references: [id], onDelete: SetNull)
  origin String @default("PLANNED")
  active Boolean @default(true)
  exclusionReason String?
  excludedAt DateTime?
  restoredAt DateTime?
  targetUrls String[] @default([])
  sourceUrl String?
  pool String @default("RESEARCH")
  reviewStatus String @default("UNREVIEWED")
  mappingStatus String @default("UNMAPPED")
  candidateUrls String[] @default([])
  auditReason String?
  protected Boolean @default(false)
  curatedAt DateTime?
  curationId String?
  createdAt DateTime @default(now())
  topicAssignments SiteKeywordTopic[]
  @@id([siteDomain, keywordId])
  @@index([siteDomain, active])
  @@index([siteDomain, pool])
}

model SiteKeywordTopic {
  siteDomain String
  keywordId String
  topicId String
  siteKeyword SiteKeyword @relation(fields: [siteDomain, keywordId], references: [siteDomain, keywordId], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  @@id([siteDomain, keywordId, topicId])
}

model RankingCapture {
  id String @id
  siteDomain String
  site SeoSite @relation(fields: [siteDomain], references: [domain])
  source String
  region SearchRegion
  captureDate DateTime @db.Date
  coverage String @default("tracked")
  status String @default("PARTIAL")
  updatedAt DateTime @updatedAt
  observations KeywordObservation[]
  @@index([siteDomain, region, source, captureDate(sort: Desc)])
}

model KeywordPageObservation {
  id String @id @default(cuid())
  siteDomain String
  site SeoSite @relation(fields: [siteDomain], references: [domain])
  keywordId String
  keyword Keyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  importId String
  importBatch RankingImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  region SearchRegion
  source String
  url String
  rank Float?
  clicks Int?
  impressions Int?
  ctr Float?
  periodStart DateTime? @db.Date
  periodEnd DateTime? @db.Date
  collectedAt DateTime
  dataUpdatedAt DateTime?
  importedAt DateTime @default(now())
  @@unique([importId, keywordId, region, source, url])
  @@index([siteDomain, keywordId, region, source, collectedAt(sort: Desc)])
}

model WeeklyTraffic {
  id String @id @default(cuid())
  siteDomain String
  site SeoSite @relation(fields: [siteDomain], references: [domain])
  importId String
  importBatch RankingImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  periodStart DateTime @db.Date
  periodEnd DateTime @db.Date
  timezone String @default("Asia/Shanghai")
  newUsers Int
  newRegistrations Int
  registrationMetric String @default("sign_up_distinct_users")
  ga4PropertyId String?
  collectedAt DateTime
  importedAt DateTime @default(now())
  @@unique([importId, periodStart, periodEnd])
  @@index([siteDomain, periodStart, periodEnd, collectedAt(sort: Desc)])
}

model DailyRankingReport {
  id String @id @default(cuid())
  siteDomain String
  site SeoSite @relation(fields: [siteDomain], references: [domain])
  importId String
  importBatch RankingImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  date DateTime @db.Date
  publishedWeek DateTime? @db.Date
  region SearchRegion
  source String
  top10 Int
  top30 Int
  top50 Int
  top100 Int
  totalKeywords Int
  rankings Json
  sourceUrl String
  collectedAt DateTime
  importedAt DateTime @default(now())
  @@unique([importId, date, region, source])
  @@index([region, date, siteDomain, source, collectedAt(sort: Desc)])
}

model Topic {
  id          String          @id @default(cuid())
  text        String          @unique
  type        TopicType       @default(MAIN)
  active      Boolean         @default(true)
  parentId    String?
  parent      Topic?          @relation("TopicTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Topic[]         @relation("TopicTree")
  parentEdges TopicRelation[] @relation("TopicRelationParent")
  childEdges  TopicRelation[] @relation("TopicRelationChild")
  keywords    Keyword[]
  sites SiteTopic[]
  siteKeywords SiteKeyword[]
  siteKeywordAssignments SiteKeywordTopic[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([parentId])
  @@index([type])
  @@index([active])
}

model TopicRelation {
  id        String   @id @default(cuid())
  parentId  String
  childId   String
  parent    Topic    @relation("TopicRelationParent", fields: [parentId], references: [id], onDelete: Cascade)
  child     Topic    @relation("TopicRelationChild", fields: [childId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([parentId, childId])
  @@index([parentId])
  @@index([childId])
}

model KeywordRelation {
  id        String   @id @default(cuid())
  parentId  String
  childId   String
  parent    Keyword  @relation("KeywordRelationParent", fields: [parentId], references: [id], onDelete: Cascade)
  child     Keyword  @relation("KeywordRelationChild", fields: [childId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([parentId, childId])
  @@index([parentId])
  @@index([childId])
}

model SyncRun {
  id           String            @id @default(cuid())
  status       RunStatus         @default(RUNNING)
  provider     String            @default("serpapi")
  startedAt    DateTime          @default(now())
  finishedAt   DateTime?
  regions      SearchRegion[]
  summary      Json?
  errorMessage String?
  snapshots    RankingSnapshot[]
  diffs        RankingDiff[]
  volumes      KeywordVolume[]
}

model RankingSnapshot {
  id           String       @id @default(cuid())
  keywordId    String
  keyword      Keyword      @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  runId        String?
  run          SyncRun?     @relation(fields: [runId], references: [id], onDelete: SetNull)
  region       SearchRegion
  rank         Int?
  bucket       RankBucket
  url          String?
  title        String?
  searchVolume Int?
  checkedAt    DateTime     @default(now())

  @@index([keywordId, region, checkedAt])
  @@index([runId])
  @@index([bucket])
}

model RankingDiff {
  id             String       @id @default(cuid())
  keywordId      String
  keyword        Keyword      @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  runId          String
  run            SyncRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  region         SearchRegion
  previousRank   Int?
  currentRank    Int?
  rankDelta      Int?
  previousBucket RankBucket?
  currentBucket  RankBucket
  changed        Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@unique([keywordId, region, runId])
  @@index([keywordId, region, createdAt])
  @@index([changed])
}

model KeywordVolume {
  id        String        @id @default(cuid())
  keywordId String
  keyword   Keyword       @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  runId     String?
  run       SyncRun?      @relation(fields: [runId], references: [id], onDelete: SetNull)
  region    SearchRegion?
  volume    Int
  source    String        @default("ahrefs")
  fetchedAt DateTime      @default(now())
  observedAt DateTime?

  @@index([keywordId, region, fetchedAt])
  @@index([runId])
}

// Site-scoped before/after snapshots make a curation batch reversible without
// deleting shared Keyword records or any ranking/volume observations.
model KeywordCurationAudit {
  id String @id
  siteDomain String
  payloadHash String
  status String @default("APPLIED")
  before Json
  after Json
  summary Json
  appliedAt DateTime @default(now())
  restoredAt DateTime?
  @@index([siteDomain, appliedAt])
}

model KeywordContentTask {
  id String @id
  siteDomain String
  auditId String
  plannedUrl String
  type String
  status String @default("TODO")
  title String
  reason String
  keywords String[] @default([])
  targetUrls String[] @default([])
  owner String?
  dueAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([siteDomain, status])
  @@index([auditId])
}

// Latest accepted source row, keyed by document source and stable business ID.
// Absent rows and removed source keywords never delete tracked inventory.
model KeywordSourceRow {
  siteDomain String
  sourceId String
  rowKey String
  snapshotHash String
  snapshot Json
  observedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@id([siteDomain, sourceId, rowKey])
  @@index([siteDomain, sourceId])
}
