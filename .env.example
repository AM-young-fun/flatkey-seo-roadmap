# Database
# Use a pooled PostgreSQL URL for Vercel serverless functions when your provider offers one.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# App
NEXT_PUBLIC_APP_NAME="SEO Rank Monitor"
APP_BASE_URL="http://localhost:3000"

# Cron/API protection
# Vercel Cron sends this as: Authorization: Bearer <CRON_SECRET>
CRON_SECRET="replace-with-a-long-random-token"

# Rank tracking target
# The Google result URL is matched against this domain. Example: "example.com"
SEO_TARGET_DOMAIN="example.com"
GOOGLE_RESULTS_DEPTH="50"
GOOGLE_TIMEOUT_MS="15000"
DISABLE_EXTERNAL_FETCH="false"

# Google SERP provider
# Supported values: "serpapi" or "mock"
GOOGLE_SEARCH_PROVIDER="serpapi"
SERPAPI_API_KEY=""
SERPAPI_ENDPOINT="https://serpapi.com/search.json"

# Ahrefs volume provider
# If AHREFS_API_TOKEN or AHREFS_API_URL_TEMPLATE is empty, the app uses deterministic demo volume.
AHREFS_API_TOKEN=""
AHREFS_API_BASE_URL="https://api.ahrefs.com/v3"
AHREFS_API_URL_TEMPLATE="https://api.ahrefs.com/v3/keywords-explorer/overview?country={country}&keywords={keyword}"
AHREFS_TIMEOUT_MS="15000"
